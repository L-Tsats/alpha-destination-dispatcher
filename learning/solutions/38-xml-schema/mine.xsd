<?xml version="1.0" encoding="UTF-8"?>
<!-- Reference answer for the <song> task in exercise 38. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- restricted type for mood, used by the <mood> element below -->
  <xs:simpleType name="MoodType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="CALM"/>
      <xs:enumeration value="HAPPY"/>
      <xs:enumeration value="SAD"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="song">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="title"         type="xs:string"/>
        <xs:element name="artist"        type="xs:string" maxOccurs="unbounded"/>
        <xs:element name="lengthSeconds" type="xs:int"/>
        <xs:element name="mood"          type="MoodType"/>
        <xs:element name="remix"         type="xs:string" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:int" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>

<!--
  A conforming document would look like:
      <song id="1">
        <title>Clair de Lune</title>
        <artist>Debussy</artist>
        <lengthSeconds>300</lengthSeconds>
        <mood>CALM</mood>
      </song>
  (remix omitted because it's optional; artist could repeat.)
-->
