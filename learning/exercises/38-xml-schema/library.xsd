<?xml version="1.0" encoding="UTF-8"?>
<!--
  A schema (XSD) describes the SHAPE of a valid XML document.
  It declares WHAT tags exist, their TYPES, ORDER, and how MANY.
  It never contains the actual data - YOU supply that in the .xml document.

  This schema describes a <library> of <book> entries.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- A reusable TYPE for money: a decimal value PLUS a 'currency' attribute.
       This is the "extension base" pattern: the element's TEXT is a decimal
       (the base), and we EXTEND it to also carry an attribute. -->
  <xs:complexType name="PriceType">
    <xs:simpleContent>
      <xs:extension base="xs:decimal">
        <xs:attribute name="currency" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- A restricted type: the text must be ONE of these exact values. -->
  <xs:simpleType name="GenreType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="FICTION"/>
      <xs:enumeration value="SCIENCE"/>
      <xs:enumeration value="HISTORY"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A <book>: a container (complexType) whose children must appear in the
       given ORDER (sequence). It also has a required 'isbn' attribute. -->
  <xs:complexType name="BookType">
    <xs:sequence>
      <xs:element name="title"  type="xs:string"/>
      <xs:element name="author" type="xs:string" maxOccurs="unbounded"/>
      <xs:element name="year"   type="xs:int"/>
      <xs:element name="genre"  type="GenreType"/>
      <xs:element name="price"  type="PriceType"/>
      <xs:element name="note"   type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="isbn" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- The ROOT element: a <library> holding 1+ <book> children. -->
  <xs:element name="library">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="book" type="BookType" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
