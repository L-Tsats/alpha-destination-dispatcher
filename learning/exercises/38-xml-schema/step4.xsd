<?xml version="1.0" encoding="UTF-8"?>
<!-- STEP 4: adding an attribute (lives in the start tag, declared after the sequence). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="person">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="name" type="xs:string"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:int" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>

<!--
  Describes:   <person id="7"><name>Anna</name></person>
  Note where id goes: INSIDE the start tag, not as a child element.
  Drop use="required" and the id attribute becomes optional.
-->
