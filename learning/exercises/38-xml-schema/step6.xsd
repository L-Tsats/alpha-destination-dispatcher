<?xml version="1.0" encoding="UTF-8"?>
<!-- STEP 6: restricting allowed values with simpleType + restriction + enumeration. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- Define a named, restricted type... -->
  <xs:simpleType name="GenreType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="FICTION"/>
      <xs:enumeration value="SCIENCE"/>
      <xs:enumeration value="HISTORY"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ...then USE it as a type, just like xs:string. -->
  <xs:element name="genre" type="GenreType"/>

</xs:schema>

<!--
  Describes:   <genre>SCIENCE</genre>     (allowed)
  but NOT:     <genre>COOKING</genre>     (not in the enumeration)
  base="xs:string" = "start from text, then narrow what's allowed."
-->
